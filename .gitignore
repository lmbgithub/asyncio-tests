# Byte-compiled / cached
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging and build artifacts
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Test, coverage and type-check caches
.pytest_cache/
